# 复制为 .env 后 chmod 600。凭据只放本目录，不要和其他项目共用。

# 对外名称。后台标题、群里的自我介绍、未开通提示都用这些。
BOT_NAME=AI 资讯
BOT_NAME_EN=Newsbot
BOT_TAGLINE=群里的 AI 资讯简报员
# 可选。写了会进 Artificial Analysis 请求的 User-Agent。
# PUBLIC_URL=https://example.com

# 飞书企业自建应用（开放平台 → 凭证与基础信息）
# 也可不写，改在后台「设置 → 飞书应用」保存到 data/feishu-auth.json（优先于这里）
FEISHU_APP_ID=cli_xxxxxxxx
FEISHU_APP_SECRET=xxxxxxxx
# 群开通名单改在后台勾选，不必写在这里
FEISHU_CHAT_ALLOWLIST=

# Grok 订阅（官方 OIDC device flow，不是 XAI_API_KEY）
# 在容器或本目录里跑：npm run xai:login
XAI_API_BASE=https://api.x.ai/v1
# 资讯摘要用快模型，省周额度；要更深可改 grok-4.6
XAI_MODEL=grok-4-fast

# AIHOT
AIHOT_BASE=https://aihot.virxact.com

# 额度闸，0 = 不限制（当前默认）
DAILY_USER_CAP=0
DAILY_GLOBAL_CAP=0

# 回环健康检查。公开之前请在前面加你自己的访问控制。
HOST=127.0.0.1
PORT=3520
DATA_DIR=./data
